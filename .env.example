# SkillSwap Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=generate-a-strong-random-secret-key
# For PostgreSQL (e.g. Render / local PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/skillswap
# Default fallback is SQLite in instance/skillswap.db
DATABASE_URL=sqlite:///instance/skillswap.db
